# Server Configuration
HOST=0.0.0.0
PORT=8001
API_PREFIX=/v1
LOG_LEVEL=INFO
DEBUG=false

# Vector Database (PGVector)
VECTOR_DB_TYPE=pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
COLLECTION_NAME=agentic_documents

# AWS Bedrock Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_PROFILE=default  # Alternative to access key

# Embeddings Configuration
EMBEDDINGS_PROVIDER=bedrock
EMBEDDINGS_MODEL=amazon.titan-embed-text-v1
# Other options: amazon.titan-embed-text-v2, cohere.embed-english-v3, cohere.embed-multilingual-v3
EMBEDDING_DIMENSION=1536

# LLM Configuration (for DSPy Agent)
LLM_PROVIDER=bedrock
LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# Other options: anthropic.claude-3-haiku, meta.llama3-1-70b-instruct-v1:0
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# Chunking Configuration
CHUNK_SIZE=1500
CHUNK_OVERLAP=100
CHUNKING_STRATEGY=recursive  # recursive, semantic, markdown, code

# File Storage
FILE_STORAGE_TYPE=local
FILE_UPLOAD_PATH=./uploads
FILE_MAX_SIZE_MB=50
FILE_ALLOWED_EXTENSIONS=pdf,docx,txt,csv,xlsx,json,md,pptx,py,js,ts,java,cpp,c,html,xml

# Code Execution (Subprocess)
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_TIMEOUT=30
CODE_EXECUTION_MAX_OUTPUT_SIZE=1000000
ALLOWED_PYTHON_MODULES=pandas,numpy,json,csv,re,math,datetime,collections

# Security
JWT_SECRET=your-secret-key-change-this-in-production
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3080

# Rate Limiting
MAX_CONCURRENT_REQUESTS=10
RATE_LIMIT_UPLOADS=10
RATE_LIMIT_QUERIES=30

# Cleanup
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=24
CLEANUP_FILE_MAX_AGE_HOURS=168  # 7 days
